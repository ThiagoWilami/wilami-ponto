// ===== Regras para as coleções novas do Wilami Ponto & RH =====
// Cole estes blocos DENTRO do bloco existente:
//   match /databases/{database}/documents { ... }
// sem apagar as regras que você já tem.
// Se você usa vários clientes (tenants) e as regras de /tenants/... NÃO liberam tudo,
// copie os mesmos blocos também para dentro de: match /tenants/{tenant} { ... }

// Arquivos (pastas, holerites, contratos, documentos do convite)
match /arquivos/{id} {
  allow read: if true;                       // app "Meus documentos" lê os próprios arquivos
  allow create: if true;                     // painel e candidato do convite enviam arquivos
  allow update: if request.auth != null
    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vistoEm']);  // colaborador marca "visto"
  allow delete: if request.auth != null;
}
match /arquivos_partes/{id} {
  allow read: if true;
  allow create: if true;
  allow update: if false;
  allow delete: if request.auth != null;
}

// PIN do app "Meus documentos" (só o hash é guardado)
match /acessosColab/{id} {
  allow read: if true;
  allow create, delete: if request.auth != null;
  allow update: if request.auth != null
    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hash','cpf','atualizadoEm','trocadoPeloColab']);
}

// Convites de cadastro (link enviado ao candidato)
match /convites/{token} {
  allow read: if true;
  allow create, delete: if request.auth != null;
  allow update: if request.auth != null
    || (resource.data.status == 'aberto'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','preenchidoEm','pessoaKey','nome']));
}
